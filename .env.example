# ─── Bolta Khata AI — Environment Variable Template ───────────
# Copy this file to .env and fill in real values.
# NEVER commit .env or real credentials to version control.

# ── Gemini AI (integration later) ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── GNANI Speech-to-Text — Prisma (integration later) ─────────
GNANI_STT_API_KEY=your_gnani_stt_api_key_here
GNANI_STT_BASE_URL=https://api.gnani.ai/stt

# ── GNANI Text-to-Speech — Timbre (integration later) ─────────
GNANI_TTS_API_KEY=your_gnani_tts_api_key_here
GNANI_TTS_BASE_URL=https://api.gnani.ai/tts

# ── Picovoice Porcupine — Wake Word (integration later) ───────
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# ── Database ───────────────────────────────────────────────────
# SQLite file path relative to backend/
DATABASE_PATH=./khata.db

# ── Backend server ─────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── CORS — comma-separated list of allowed frontend origins ────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
